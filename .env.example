# API deployment. Local `npm run dev` supplies 127.0.0.1:4151.
# HOST=0.0.0.0
# PORT=4151
# ROAMATLAS_RUNTIME_CACHE_DIR=/var/lib/roamatlas/runtime-cache

# Optional: see libs/data/src/experienceConfig.ts
# ROAMATLAS_LOAD_NEXT_DESTINATIONS_EARLY=true
