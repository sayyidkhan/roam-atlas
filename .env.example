# ROAMATLAS_INTERACTIVE_RESERVED_SLOTS=1
# ROAMATLAS_PREFETCH_DESTINATION_LIMIT=10
# Legacy combined override:
# ROAMATLAS_MAX_PARALLEL_IMAGE_JOBS=10
# ROAMATLAS_LOAD_COUNTRY_PACK_EARLY=false
# ROAMATLAS_SHOW_LOADING_STEPS=true
