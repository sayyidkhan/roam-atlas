{
  "name": "roamatlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test test/*.test.js",
    "test:react": "vitest run test/components",
    "test:contract": "vitest run test/contracts",
    "test:browser": "playwright test",
    "typecheck": "tsc --build --pretty false",
    "typecheck:clean": "tsc --build --clean",
    "lint": "eslint . && npm run lint:css",
    "lint:css": "stylelint \"apps/web/src/**/*.css\"",
    "lint:css:fix": "stylelint \"apps/web/src/**/*.css\" --fix",
    "dev": "concurrently --kill-others --success first npm:dev:api npm:dev:web",
    "dev:api": "npm run dev --workspace @roamatlas/api",
    "dev:web": "npm run dev --workspace @roamatlas/web",
    "start:api": "npm run start --workspace @roamatlas/api",
    "check:api": "npm run check --workspace @roamatlas/api",
    "preview:web": "npm run preview --workspace @roamatlas/web",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace @roamatlas/web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
